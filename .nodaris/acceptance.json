{
  "name": "Nodaris harness, version 1 for the team",
  "checks": [
    {"id": "tests", "title": "Every test passes",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider"], "env": {"NODARIS_HARNESS_NO_BG": "1"}, "timeout": 900},
    {"id": "python39", "title": "The engine, installer and scripts compile on Python 3.9",
     "run": ["/usr/bin/python3", "-m", "py_compile", "install.py", "team.py", "scripts/check_teammate_install.py",
             "engine/nodaris_harness/cli.py", "engine/nodaris_harness/dispatch.py", "engine/nodaris_harness/sync.py",
             "engine/nodaris_harness/ready.py", "engine/nodaris_harness/graph.py", "engine/nodaris_harness/onboard.py",
             "engine/nodaris_harness/capsule.py", "engine/nodaris_harness/monitor.py", "engine/nodaris_harness/hosts.py"]},
    {"id": "teammate-install", "title": "A teammate can install, use and uninstall it cleanly (from this checkout)",
     "run": ["python3", "scripts/check_teammate_install.py", "--source", "."], "timeout": 900},
    {"id": "onboarding-once", "title": "Onboarding is offered once per install, never every session or prompt",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_onboard.py", "-k", "offer or onboarding or first"],
     "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "onboarding-cli", "title": "The onboarding CLI has its animated splash, single-key answers and a plain mode",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_tui.py"], "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "own-cli", "title": "The live panel and status line show tokens, subagents, memories and files",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_monitor.py"], "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "no-repeats", "title": "The same guidance is never injected twice in a session",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_engine.py", "-k", "repeated", "engine/tests/test_learner.py", "-k", "repeated or together"],
     "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "subagents", "title": "Helper agents get the orchestrator's frame, checkpoints and a token budget",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_capsule.py"], "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "done-loop", "title": "The harness can ask \"are we done?\" in a loop",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_ready.py"], "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "team-memory", "title": "Lessons and usage counts go to the memory vault and the team's lessons come back",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_sync.py"], "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "vault-ready", "title": "The memory vault accepts team memory (team folder and its check merged)",
     "owner": "Varun", "action": "Approve the push of the vault branch feat/team-memory on Telegram and merge its pull request",
     "run": ["gh", "api", "repos/NodarisAI/Nodaris-Memory-Vault/contents/team/README.md?ref=main", "--silent"]},
    {"id": "graphs", "title": "Code graphs are offered in onboarding and build for a repository",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_graph.py"], "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "graphs-built", "title": "This repository has both code graphs built",
     "files": ["graphify-out/graph.json", "graphify-out/GRAPH_REPORT.md"],
     "run": ["code-review-graph", "status", "--repo", "."]},
    {"id": "creative", "title": "Motion, video and CLI animation requests reach the creative pack",
     "files": ["packs/creative/skills/creative-studio/SKILL.md", "packs/creative/skills/terminal-motion/SKILL.md",
               "packs/creative/skills/video-toolkit/SKILL.md", "packs/creative/skills/motion-design-direction/SKILL.md"],
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "engine/tests/test_router.py", "-k", "media or creative or video"],
     "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "guards", "title": "The credential check, reversible delete and deny rules ship in the core pack",
     "run": ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "packs/core/vendor/guards", "engine/tests/test_hosts.py", "-k", "deny or literal or reversible or secret"],
     "env": {"NODARIS_HARNESS_NO_BG": "1"}},
    {"id": "guards-live", "title": "Varun's own machine runs the new guards",
     "owner": "Varun", "action": "Run bash ~/ai-os/scripts/admin/install-guard-update.sh",
     "run": ["sh", "-c", "cmp -s \"$HOME/.claude/hooks-staging/secret-guard.py\" \"$HOME/.claude/hooks/secret-guard.py\" && cmp -s \"$HOME/.claude/hooks-staging/destructive-guard.py\" \"$HOME/.claude/hooks/destructive-guard.py\""]},
    {"id": "docs", "title": "Every document a teammate needs is present",
     "files": ["README.md", "INSTALL.md", "AGENTS.md", "CLAUDE.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md",
               "LICENSE", "NOTICE.md", "docs/TEAM-DATA.md", "docs/ARCHITECTURE.md", "docs/GITHUB-SETUP.md"]},
    {"id": "setup-prompt", "title": "The README carries the one-line setup prompt and says who it is for",
     "contains": {"README.md": ["Install the harness from https://github.com/NodarisAI/Coding-Agent_Harness", "## Who it is for"]}},
    {"id": "licence", "title": "The licence is Nodaris AI's own and credits its sources",
     "contains": {"LICENSE": ["Nodaris Harness Licence", "Nodaris AI"], "NOTICE.md": ["mattpocock/skills", "pstack"]}},
    {"id": "no-marks", "title": "No AI authorship marks in commit messages",
     "run": ["sh", "-c", "! git log --format=%B | grep -qiE 'co-authored-by: *claude|generated with (claude|\\[claude)|noreply@anthropic'"]},
    {"id": "no-secrets", "title": "No credentials anywhere in the repository's history",
     "run": ["gitleaks", "git", "--no-banner", "--redact", "--log-level", "error", "."], "timeout": 300},
    {"id": "landing-page", "title": "The landing page is in the repository",
     "files": ["docs/site/index.html"], "contains": {"docs/site/index.html": ["Nodaris harness"]}},
    {"id": "pushed", "title": "The branch is on GitHub with an open pull request",
     "owner": "Varun", "action": "Approve the push of feat/harness-v1 on Telegram",
     "run": ["gh", "pr", "view", "feat/harness-v1", "--repo", "NodarisAI/Coding-Agent_Harness", "--json", "number"]},
    {"id": "github-profile", "title": "The GitHub repository has a description and topics",
     "run": ["sh", "-c", "gh repo view NodarisAI/Coding-Agent_Harness --json description,repositoryTopics -q '(.description | length) > 0 and ((.repositoryTopics // []) | length) > 0' | grep -qx true"]},
    {"id": "gitdiagram", "title": "GitDiagram setup for the private repository is documented (Varun picks hosted or self-hosted)",
     "owner": "Varun", "action": "Choose hosted GitDiagram with a read-only token, or self-hosting (docs/GITDIAGRAM.md)",
     "files": ["docs/GITDIAGRAM.md"]},
    {"id": "teammate-install-github", "title": "A teammate can install it from GitHub's main branch",
     "owner": "Varun", "action": "Merge the harness pull request after review",
     "run": ["python3", "scripts/check_teammate_install.py", "--branch", "main"], "timeout": 900}
  ]
}
